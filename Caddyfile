# WarpX reverse proxy — free, automatic HTTPS via Caddy.
#
# Caddy sits in front of the Node server: it terminates HTTPS (Let's Encrypt
# gets and renews the certificate on its own, forever, with zero manual
# steps) and forwards every request to WarpX running on localhost:3000.
#
# See the "HTTPS with a reverse proxy" section in README.md for the full
# walkthrough (router port forwarding, DNS, installing Caddy, running it as
# a service). Domain's DNS must point at this Mac's public IP, not at
# GitHub Pages — the two can't both serve warpx.online at once.

warpx.online {
	reverse_proxy localhost:3000
}

# If you also want it reachable at www.warpx.online, use this block instead
# (Caddy needs each hostname listed explicitly — it won't infer www from the
# bare domain or vice versa, and www needs its own DNS A record too):
#
# warpx.online, www.warpx.online {
# 	reverse_proxy localhost:3000
# }
